<div class="section-header{% if centered %} section-header--centered{% endif %}{% if light %} section-header--light{% endif %}">
  {% if eyebrow %}<p class="section-header__eyebrow">{{ eyebrow }}</p>{% endif %}
  <h2 class="section-header__heading">{{ heading }}</h2>
  {% if subheading %}<p class="section-header__subheading">{{ subheading }}</p>{% endif %}
</div>
