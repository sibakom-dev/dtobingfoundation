<section class="hero{% if heroClass %} {{ heroClass }}{% endif %}" aria-label="Hero"
  {% if heroImage %}style="--hero-bg: url('{{ heroImage }}')"{% endif %}>
  <div class="hero__overlay" aria-hidden="true"></div>
  <div class="hero__content container">
    {% if eyebrow %}<p class="hero__eyebrow">{{ eyebrow }}</p>{% endif %}
    <h1 class="hero__heading">{{ heading | safe }}</h1>
    {% if subheading %}<p class="hero__subheading">{{ subheading }}</p>{% endif %}
    {% if ctaPrimary %}
    <div class="hero__actions">
      <a class="btn btn--navy" href="{{ ctaPrimaryUrl or '#' }}">{{ ctaPrimary }}</a>
      {% if ctaSecondary %}
      <a class="btn btn--outline-light" href="{{ ctaSecondaryUrl or '#' }}">{{ ctaSecondary }}</a>
      {% endif %}
      {% if ctaTertiary %}
      <a class="btn btn--gold" href="{{ ctaTertiaryUrl or site.donateUrl }}">
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        {{ ctaTertiary }}
      </a>
      {% endif %}
    </div>
    {% endif %}
  </div>
</section>
