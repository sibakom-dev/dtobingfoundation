---
layout: base.njk
ogType: article
---
<article class="story-page" itemscope itemtype="https://schema.org/Article">

  <header class="story-page__header">
    <div class="container">
      {% if category %}
      <a class="story-page__category" href="/stories/?category={{ category | lower }}">{{ category }}</a>
      {% endif %}
      <h1 class="story-page__title" itemprop="headline">{{ title }}</h1>
      <div class="story-page__meta">
        {% if author %}<span itemprop="author">{{ author }}</span>{% endif %}
        {% if date %}
        <time itemprop="datePublished" datetime="{{ date | isoDate }}">{{ date | formatDate }}</time>
        {% endif %}
      </div>
    </div>
    {% if coverImage %}
    <div class="story-page__cover">
      <img src="{{ coverImage }}" alt="{{ title }}" itemprop="image" loading="eager">
    </div>
    {% endif %}
  </header>

  <div class="story-page__body container rich-text" itemprop="articleBody">
    {{ content | safe }}
  </div>

  <footer class="story-page__footer container">
    <a class="btn btn--outline-navy" href="/stories/"><svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg> All Stories</a>
  </footer>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": "{{ title }}",
    "author": { "@type": "Person", "name": "{{ author }}" },
    "datePublished": "{{ date | isoDate }}",
    "image": "{{ site.siteUrl }}{{ coverImage or site.seoDefaults.image }}",
    "publisher": {
      "@type": "Organization",
      "name": "{{ site.siteName }}",
      "logo": "{{ site.siteUrl }}{{ site.logo }}"
    }
  }
  </script>
</article>
